# Copie para .env e ajuste. O arquivo .env não deve ir para o Git.
# Se o Postgres não responder, a API cria db.sqlite3 e usa esse arquivo.
# Se o bucket S3/R2 não responder, ou estas variáveis ficarem vazias, as imagens vão para media/.

POSTGRES_DB=sambaiba
POSTGRES_USER=sambaiba
POSTGRES_PASSWORD=sambaiba
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# sqlite força o arquivo local mesmo com o Postgres no ar. Vazio usa a detecção automática.
DB_ENGINE=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
# R2: https://<conta>.r2.cloudflarestorage.com  — S3: deixe vazio
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=auto
# Domínio público do bucket, sem https://. Vazio monta a URL do endpoint.
AWS_S3_CUSTOM_DOMAIN=
